meta {
  name: Delete attempts by credential ID
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/test-only/phone-number-attempts/{{credentialId}}
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:6083
  credentialId: 666
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
